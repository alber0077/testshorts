# OpenAI-compatible LLM endpoint (Cloud or Local Ollama/LM Studio)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here

# Global Voice Style Lock (keeps all Shorts sounding identical)
DEFAULT_VOICE_REF=assets/voices/narrator.wav
TTS_EXAGGERATION=0.55
TTS_CFG_WEIGHT=0.50
TTS_TEMPERATURE=0.70
TTS_SEED=42

# Compute device: auto | mps | cpu | cuda
PIPELINE_DEVICE=auto

# WhisperX alignment model size
WHISPER_MODEL=large-v3-turbo
